{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "agent",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "go run ./cmd/agent --gateway-url https://127.0.0.1:8443 --api-key jagr-dev-key --mode batch --tls-skip-verify"
        },
        {
            "label": "gateway",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "direnv exec . go run ./cmd/gateway --config gateway.yaml --log-format console"
        },
        {
            "label": "web",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "command": "npm run dev"
        },
        {
            "label": "build-prod",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "make build-prod",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "build-agent-prod",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "make build-agent-prod"
        },
        {
            "label": "build-gateway-prod",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "make build-gateway-prod"
        }
    ]
}